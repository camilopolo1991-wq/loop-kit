#!/usr/bin/env bash
# loop-skill-lint [<skills folder>] : judges every SKILL.md under the folder named by the one positional argument, or by
#   LOOP_SKILLS_DIR when none is given. Rules, output and exit codes are in bin/loop_skill_lint.py.
# Prints one line per skill (folder, lines, bytes, verdict) and one closing line with the counts of skills and broken rules.
# Exit 0 no rule is broken, 1 a rule is broken, 64 usage, 3 LOOP_PY does not resolve.
# STRUCT-01 C1.
set -euo pipefail
BIN="$(dirname "$(readlink -f "$0")")"
# LOOP_PY resolved the way the P12 stubs resolve it: the environment first, then config.env
# read with sed, and deliberately NO fallback to python3 or python on PATH.
LOOP_HOME_D="${LOOP_HOME:-$HOME/.loop}"
if [ -z "${LOOP_PY:-}" ] && [ -f "$LOOP_HOME_D/config.env" ]; then
  LOOP_PY="$(sed -n 's/^[[:space:]]*LOOP_PY=//p' "$LOOP_HOME_D/config.env" | tail -1)"
  LOOP_PY="${LOOP_PY%%#*}"
  LOOP_PY="$(printf '%s' "$LOOP_PY" | sed 's/[[:space:]]*$//')"
fi
PY="${LOOP_PY:-}"
if [ -z "$PY" ] || ! "$PY" -c 'import sys' >/dev/null 2>&1; then
  echo "loop-skill-lint: LOOP_PY does not resolve to a working python interpreter." >&2
  echo "loop-skill-lint: set LOOP_PY in the environment, or as LOOP_PY= in $LOOP_HOME_D/config.env." >&2
  echo "loop-skill-lint: there is no fallback to python3 on PATH, by design." >&2
  exit 3
fi
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) BIN_NATIVE="$(cygpath -m "$BIN" 2>/dev/null || printf '%s' "$BIN")";;
  *) BIN_NATIVE="$BIN";;
esac
exec "$PY" "$BIN_NATIVE/loop_skill_lint.py" "$@"
